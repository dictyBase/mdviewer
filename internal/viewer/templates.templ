package viewer

// Base layout template with Pico CSS
templ BaseLayout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<title>{ title }</title>
			<style>
				.file-list {
					list-style: none;
					padding: 0;
				}
				.file-list li {
					margin: 0.5rem 0;
				}
				.file-list a {
					display: block;
					padding: 0.75rem 1rem;
					background: var(--pico-card-background-color);
					border: 1px solid var(--pico-card-border-color);
					border-radius: var(--pico-border-radius);
					text-decoration: none;
					transition: background-color 0.2s ease;
				}
				.file-list a:hover {
					background: var(--pico-secondary-background);
				}
				pre {
					overflow-x: auto;
				}
				.code-block-wrapper {
					position: relative;
				}
				.code-block-wrapper pre {
					padding-right: 2.5rem;
				}
				.copy-btn {
					position: absolute;
					top: 0.5rem;
					right: 0.5rem;
					width: 1.75rem;
					height: 1.75rem;
					display: flex;
					align-items: center;
					justify-content: center;
					padding: 0;
					line-height: 1;
					border-radius: var(--pico-border-radius);
					border: 1px solid var(--pico-card-border-color);
					background: var(--pico-card-background-color);
					color: inherit;
					cursor: pointer;
				}
				.copy-btn:hover {
					color: var(--pico-primary);
					border-color: currentColor;
				}
				.copy-btn svg {
					display: block;
					flex: none;
				}
				.copy-btn.copied {
					color: var(--pico-primary);
					border-color: currentColor;
				}
				.copy-btn.error {
					color: var(--pico-del-color);
					border-color: currentColor;
				}
				code {
					font-size: 0.875em;
				}
				.highlight {
					background: var(--pico-code-background-color);
					border-radius: var(--pico-border-radius);
					padding: 1rem;
					margin: 1rem 0;
				}
				blockquote {
					border-left: 4px solid var(--pico-primary);
					padding-left: 1rem;
					margin-left: 0;
					font-style: italic;
				}
				.markdown-alert {
					--alert-color: var(--pico-primary);
					border-left: 4px solid var(--alert-color);
					border-radius: var(--pico-border-radius);
					background: color-mix(in srgb, var(--alert-color) 10%, transparent);
					padding: 0.75rem 1rem;
					margin: 1rem 0;
					font-style: normal;
				}
				.markdown-alert-title {
					color: var(--alert-color);
					font-weight: 700;
					margin-bottom: 0.5rem;
				}
				.markdown-alert > :last-child {
					margin-bottom: 0;
				}
				.markdown-alert-note {
					--alert-color: light-dark(#0969da, #58a6ff);
				}
				.markdown-alert-tip {
					--alert-color: light-dark(#1a7f37, #3fb950);
				}
				.markdown-alert-important {
					--alert-color: light-dark(#8250df, #bc8cff);
				}
				.markdown-alert-warning {
					--alert-color: light-dark(#9a6700, #d29922);
				}
				.markdown-alert-caution {
					--alert-color: light-dark(#cf222e, #ff7b72);
				}
				.mermaid-error {
					color: var(--pico-del-color);
					font-size: 0.875rem;
					margin-top: 0.5rem;
				}
				table {
					margin: 1rem 0;
				}
				.task-list {
					list-style: none;
					padding-left: 0;
				}
				.task-list li {
					margin: 0.25rem 0;
				}
				.task-list input[type="checkbox"] {
					margin-right: 0.5rem;
				}
				.mermaid {
					display: flex;
					justify-content: center;
					margin: 1.5rem 0;
				}
				.mermaid svg {
					max-width: 100%;
					height: auto;
				}

				/* GitHub-style file box */
				.github-breadcrumb {
					display: flex;
					align-items: center;
					gap: 0.5rem;
					margin-bottom: 0.75rem;
					font-size: 0.875rem;
				}
				.github-breadcrumb a {
					text-decoration: none;
					color: var(--pico-primary);
				}
				.github-breadcrumb-path {
					color: var(--pico-muted-color);
				}

				.github-file-box {
					background: var(--pico-background-color);
					border: 1px solid var(--pico-card-border-color);
					border-radius: var(--pico-border-radius);
					overflow: hidden;
				}

				.github-file-header {
					background: var(--pico-card-background-color);
					border-bottom: 1px solid var(--pico-card-border-color);
					padding: 0.5rem 1rem;
					display: flex;
					align-items: center;
					justify-content: space-between;
					font-size: 0.8125rem;
				}
				.github-file-header-tabs {
					display: flex;
					gap: 0.25rem;
				}
				.github-tab {
					padding: 0.25rem 0.75rem;
					border-radius: var(--pico-border-radius);
					cursor: pointer;
				background: none;
				border: none;
				font-size: inherit;
				font-family: inherit;
				line-height: inherit;
					color: var(--pico-muted-color);
				}
				.github-tab.active {
					background: var(--pico-background-color);
					color: var(--pico-color);
					font-weight: 500;
				}
				.github-file-header-actions {
					display: flex;
					align-items: center;
					gap: 0.75rem;
					color: var(--pico-muted-color);
					font-size: 0.8125rem;
				}

				/* Table grid */
				.github-file-box article table {
					border-collapse: collapse;
					width: 100%;
					border: 1px solid var(--pico-card-border-color);
				}
				.github-file-box article th,
				.github-file-box article td {
					border: 1px solid var(--pico-card-border-color);
					padding: 6px 13px;
				}
				.github-file-box article tr:nth-child(even) {
					background-color: var(--pico-secondary-background);
				}
				.github-file-box article th {
					background-color: var(--pico-card-background-color);
					font-weight: 600;
				}

				/* Heading underlines */
				.github-file-box article h1,
				.github-file-box article h2 {
					border-bottom: 1px solid var(--pico-card-border-color);
					padding-bottom: 0.3em;
				}

				/* Inline code */
				.github-file-box article :not(pre) > code {
					background-color: var(--pico-code-background-color);
					padding: 0.2em 0.4em;
					border-radius: 6px;
					font-size: 85%;
				}
			</style>
		</head>
		<body>
			<main class="container">
				@content
			</main>
			<script>
				const showMermaidError = (diagram) => {
					if (diagram.nextElementSibling?.classList.contains("mermaid-error")) {
						return;
					}
					const message = document.createElement("p");
					message.className = "mermaid-error";
					message.setAttribute("role", "status");
					message.textContent = "This diagram could not be rendered. Mermaid source is shown above.";
					diagram.insertAdjacentElement("afterend", message);
				};
				const restoreMermaidSource = (diagram, source) => {
					diagram.replaceChildren(document.createTextNode(source));
				};

				let mermaidScriptPromise;
				const loadMermaid = () => {
					if (mermaidScriptPromise) {
						return mermaidScriptPromise;
					}
					mermaidScriptPromise = new Promise((resolve, reject) => {
						const script = document.createElement("script");
						script.src = "/_mdviewer/assets/mermaid-11.12.2.min.js";
						script.onload = () => {
							try {
								if (!globalThis.mermaid) {
									throw new Error("Mermaid runtime unavailable");
								}
								globalThis.mermaid.initialize({ startOnLoad: false, securityLevel: "strict" });
								resolve(globalThis.mermaid);
							} catch (error) {
								reject(error);
							}
						};
						script.onerror = reject;
						document.head.appendChild(script);
					});
					return mermaidScriptPromise;
				};

				const renderMermaid = async (root = document) => {
					const diagrams = [...root.querySelectorAll(".mermaid")];
					if (diagrams.length === 0) {
						return;
					}
					try {
						const mermaid = await loadMermaid();
						for (const diagram of diagrams) {
							const source = diagram.textContent ?? "";
							try {
								await mermaid.run({ nodes: [diagram] });
							} catch (error) {
								restoreMermaidSource(diagram, source);
								console.error("Unable to render Mermaid diagram", error);
								showMermaidError(diagram);
							}
						}
					} catch (error) {
						console.error("Unable to render Mermaid diagrams", error);
						diagrams.forEach((diagram) => showMermaidError(diagram));
					}
				};
				void renderMermaid();

				const COPY_ICON = `<svg aria-hidden="true" focusable="false" height="16" viewBox="0 0 16 16" version="1.1" width="16" fill="currentColor"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path></svg>`;

				const CHECK_ICON = `<svg aria-hidden="true" focusable="false" height="16" viewBox="0 0 16 16" version="1.1" width="16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path></svg>`;

				const ERROR_ICON = `<svg aria-hidden="true" focusable="false" height="16" viewBox="0 0 16 16" version="1.1" width="16" fill="currentColor"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L9.06 8l3.22 3.22a.75.75 0 1 1-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 0 1-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"></path></svg>`;

				const initCopyButtons = (root = document) => {
					root.querySelectorAll("pre").forEach((pre) => {
						if (pre.closest(".code-block-wrapper") || pre.closest(".github-view-raw")) {
							return;
						}
						const code = pre.querySelector(":scope > code");
						// Ignore visually empty blocks, but preserve original whitespace when copying.
						if (!code || !code.textContent.trim()) {
							return;
						}

					const wrapper = document.createElement("div");
					wrapper.className = "code-block-wrapper";
					pre.parentNode.insertBefore(wrapper, pre);
					wrapper.appendChild(pre);

					const button = document.createElement("button");
					button.className = "copy-btn";
					button.type = "button";
					button.setAttribute("aria-label", "Copy code to clipboard");
					button.setAttribute("aria-live", "polite");
					button.setAttribute("aria-atomic", "true");
					button.innerHTML = COPY_ICON;
					wrapper.appendChild(button);

					let resetTimer;
					button.addEventListener("click", async () => {
						clearTimeout(resetTimer);
						button.classList.remove("copied", "error");
						try {
							const text = code.textContent ?? pre.textContent ?? "";
							await navigator.clipboard.writeText(text);
							button.innerHTML = CHECK_ICON;
							button.setAttribute("aria-label", "Copied!");
							button.classList.add("copied");
						} catch {
							button.innerHTML = ERROR_ICON;
							button.setAttribute("aria-label", "Error copying code");
							button.classList.add("error");
						}
						resetTimer = setTimeout(() => {
							button.innerHTML = COPY_ICON;
							button.setAttribute("aria-label", "Copy code to clipboard");
							button.classList.remove("copied", "error");
						}, 1500);
					});
				});
				initCopyButtons();

				document.querySelectorAll(".github-tab").forEach((tab) => {
					tab.addEventListener("click", () => {
						const view = tab.dataset.view;
						const box = tab.closest(".github-file-box");
						box.querySelectorAll(".github-tab").forEach((t) => t.classList.remove("active"));
						tab.classList.add("active");
						const article = box.querySelector("article");
						const raw = box.querySelector(".github-view-raw");
						if (view === "raw") {
							article.hidden = true;
							raw.hidden = false;
						} else {
							article.hidden = false;
							raw.hidden = true;
						}
					});
				});

				// Live reload: subscribe to server-sent change events and swap the
				// preview in place when the file changes, preserving scroll and tab state.
				const liveReload = () => {
					const box = document.querySelector(".github-file-box");
					const article = box?.querySelector(".github-view-preview");
					const raw = box?.querySelector(".github-view-raw");
					if (!box || !article || !raw) {
						return;
					}

					const initialEtag = box.dataset.contentEtag ?? "";
					let etag = initialEtag ? `"${initialEtag}"` : "";
					const url = "/_mdviewer/content" + location.pathname;

					const applyUpdate = async () => {
						try {
							const response = await fetch(url, {
								headers: etag ? { "If-None-Match": etag } : {},
							});
							if (response.status === 304) {
								return;
							}
							if (!response.ok) {
								console.warn("mdviewer: live reload request failed with status", response.status);
								return;
							}
							const data = await response.json();
							const nextEtag = response.headers.get("ETag");
							article.innerHTML = data.html;
							raw.textContent = data.raw;
							if (nextEtag) {
								etag = nextEtag;
							}
							initCopyButtons(article);
							void renderMermaid(article);
						} catch (error) {
							console.warn("mdviewer: live reload failed", error);
						}
					};

					// Fall back to polling if the event stream closes (e.g. server restart).
					let pollingFallback = false;
					const startPollingFallback = () => {
						if (pollingFallback) {
							return;
						}
						pollingFallback = true;
						const poll = async () => {
							await applyUpdate();
							setTimeout(poll, 1000);
						};
						void poll();
					};

					const source = new EventSource("/_mdviewer/events");
					source.onopen = () => {
						void applyUpdate();
					};
					source.onmessage = () => {
						void applyUpdate();
					};
					source.onerror = () => {
						if (source.readyState === EventSource.CLOSED) {
							startPollingFallback();
						}
					};
				};
				liveReload();
			</script>
		</body>
	</html>
}

// Index page showing all markdown files
templ IndexPage(files []string) {
	@BaseLayout("Markdown Viewer", IndexContent(files))
}

templ IndexContent(files []string) {
	<header>
		<h1>📚 Markdown Files</h1>
		<p>Select a markdown file to view</p>
	</header>
	if len(files) == 0 {
		<article>
			<p>No markdown files found in the current directory.</p>
		</article>
	} else {
		<section>
			<ul class="file-list">
				for _, file := range files {
					<li>
						<a href={ templ.SafeURL("/" + removeMarkdownExt(file)) }>
							{ file }
						</a>
					</li>
				}
			</ul>
		</section>
	}
}

// Markdown file page
templ MarkdownPage(filename string, content string, headings []Heading, rawMarkdown string, etag string) {
	@BaseLayout(filename+" - Markdown Viewer", MarkdownContent(filename, content, headings, rawMarkdown, etag))
}

templ MarkdownContent(filename string, content string, headings []Heading, rawMarkdown string, etag string) {
	<div class="github-breadcrumb">
		<a href="/">← Back</a>
		<span class="github-breadcrumb-path">{ filename }</span>
	</div>
	<div class="github-file-box" data-content-etag={ etag }>
		<div class="github-file-header" id="github-file-header">
			<div class="github-file-header-tabs">
				<button class="github-tab active" data-view="preview" type="button">Preview</button>
				<button class="github-tab" data-view="raw" type="button">Raw</button>
			</div>
			<div class="github-file-header-actions">
				<span>{ filename }</span>
			</div>
		</div>
		<article class="github-view-preview">
			@templ.Raw(content)
		</article>
		<pre class="github-view-raw" hidden>{ rawMarkdown }</pre>
	</div>
}
